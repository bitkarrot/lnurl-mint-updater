#!/bin/sh
set -eu

# Installed as /etc/lnurl-mint-updater.env (mode 0600).
REPO_URL=https://github.com/dni/lnurl-mint.git
BRANCH=main
APP_DIR=/opt/lnurl-mint
STATE_DIR=/var/lib/lnurl-mint-updater
LOG_DIR=/var/log/lnurl-mint-updater
SERVICE=lnurl-mint.service
MODEL_ENDPOINT=https://llm.int.exe.xyz/v1/chat/completions
MODEL=fireworks/glm-5p2
MODEL_REVIEW=true
# Automatic deployment is enabled by default for rapid-testing VMs.
AUTO_DEPLOY=true
